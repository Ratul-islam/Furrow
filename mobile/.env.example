# Optional. Without these the app runs on the bundled copy of the data (src/data/ashulia.json).
# Supabase project → Settings → API. The anon key is public by design; tables are read-only (RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phone number of the drone team, for the "Call the drone team" buttons (e.g. +8801XXXXXXXXX).
# Leave empty to hide the call buttons.
EXPO_PUBLIC_DRONE_TEAM_PHONE=
